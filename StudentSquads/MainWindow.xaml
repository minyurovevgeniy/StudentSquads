<Window x:Class="StudentSquads.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StudentSquads"
        mc:Ignorable="d" ResizeMode="NoResize"
        Title="MainWindow" Height="450" Width="800" Loaded="Window_Loaded">
    <Grid>
        <TabControl x:Name="Container" SelectionChanged="TabControl_SelectionChanged">
            <TabItem Header="Список отрядов">
                <Grid Background="#FFE5E5E5">
                    <ListView Name="squadList" Margin="0,51,0,0" Height="260" VerticalAlignment="Top" SelectionChanged="squadList_SelectionChanged">
                        <!-- SelectionChanged="squadList_SelectionChanged" -->
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{Binding Logo}" Margin="3" />
                                    <TextBlock VerticalAlignment="Center" Text="{Binding Name}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock Margin="337,19,0,0" Text="Студенческие отряды" Height="17" VerticalAlignment="Top" HorizontalAlignment="Left" Width="119"/>
                    <Button Content="Обновить список отрядов" Margin="318,363,318,0" Click="Button_Click" Height="20" VerticalAlignment="Top"/>
                </Grid>
            </TabItem>
            <TabItem Header="Общая информация">
                <Grid Background="#FFE5E5E5">
                    <TextBlock x:Name="generalInformation" HorizontalAlignment="Center" Margin="0,45,0,0" TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Top" Width="654"/>
                    <Button Content="Обновить" Margin="368,342,368,0" Click="loadGeneralInformation_Click" x:Name="loadGeneralInformation" Height="20" VerticalAlignment="Top" RenderTransformOrigin="-0.199,0.749"/>
                    <TextBlock HorizontalAlignment="Left" Margin="348,10,0,0" Text="Общая информация" VerticalAlignment="Top"/>
                </Grid>
            </TabItem>
            <TabItem Header="Объявления">
                <Grid Background="#FFE5E5E5">
                    <ListView Margin="0,39,0,79" x:Name="announcementList">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Time}" Margin="10" />
                                    <TextBlock VerticalAlignment="Center" Text="{Binding AnnouncementText}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Button Content="Обновить" x:Name="newsList" Margin="368,360,368,0" RenderTransformOrigin="1.394,0.852" Click="newsList_Click" Height="20" VerticalAlignment="Top"/>
                    <TextBlock Margin="0,10,363,0" Text="Объявления" VerticalAlignment="Top" IsHitTestVisible="False" HorizontalAlignment="Right" Width="68"/>
                </Grid>

            </TabItem>
            <TabItem Header="Расписание встреч">
                <Grid Background="#FFE5E5E5">
                    <ListView Height="290" VerticalAlignment="Top" x:Name="meetingList" Margin="0,50,0,0">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>

                                    <Grid.RowDefinitions>
                                        <RowDefinition></RowDefinition>
                                        <RowDefinition></RowDefinition>
                                        <RowDefinition></RowDefinition>
                                        <RowDefinition></RowDefinition>
                                        <RowDefinition></RowDefinition>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"></ColumnDefinition>
                                        <ColumnDefinition Width="*"></ColumnDefinition>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Grid.Row="0"  Text="Дата" Margin="5" />
                                    <TextBlock Grid.Column="1" Grid.Row="0" VerticalAlignment="Center" Text="{Binding Date}"/>

                                    <TextBlock Grid.Column="0" Grid.Row="1"  Text="День недели" Margin="5" />
                                    <TextBlock Grid.Column="1" Grid.Row="1" VerticalAlignment="Center" Text="{Binding Weekday}"/>

                                    <TextBlock Grid.Column="0" Grid.Row="2"  Text="Время начала" Margin="5" />
                                    <TextBlock Grid.Column="1" Grid.Row="2" VerticalAlignment="Center" Text="{Binding StartTime}"/>

                                    <TextBlock Grid.Column="0" Grid.Row="3"  Text="Время окончания" Margin="5" />
                                    <TextBlock Grid.Column="1" Grid.Row="3" VerticalAlignment="Center" Text="{Binding EndTime}"/>

                                    <TextBlock Grid.Column="0" Grid.Row="4"  Text="Отмена" Margin="5" />
                                    <TextBlock Grid.Column="1" Grid.Row="4" VerticalAlignment="Center" Text="{Binding IsCancelled}"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>

                    </ListView>
                    <Button Content="Загрузить"  HorizontalAlignment="Center" Margin="0,358,0,0" VerticalAlignment="Top" Click="meetingList_Click"/>
                    <TextBlock Margin="339,10,339,0" Text="Расписание встреч" VerticalAlignment="Top"/>
                </Grid>
            </TabItem>
            <TabItem Header="Случайная фотография" Height="20" VerticalAlignment="Top">
                <Grid Background="#FFE5E5E5">
                    <Image Source="{Binding randomPhoto}" x:Name="Photo" HorizontalAlignment="Left" Height="216" Margin="118,47,0,0" VerticalAlignment="Top" Width="520"/>
                    <Button x:Name="downloadPhoto" Content="Следующая фотография" HorizontalAlignment="Center" Margin="0,363,0,0" VerticalAlignment="Top" Click="downloadPhoto_Click"/>
                    <TextBlock x:Name="Description" HorizontalAlignment="Center" Margin="0,331,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="774" TextAlignment="Center"/>
                </Grid>

            </TabItem>
        </TabControl>

    </Grid>
</Window>
